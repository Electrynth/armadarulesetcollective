{
  "redirects": [
    {
      "source": "/:path((?!assets/).*)",
      "has": [
        { "type": "host", "value": "(www\\.)?armadarulesetcollective\\.com" }
      ],
      "destination": "https://www.armada.community/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
} 